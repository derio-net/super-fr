{
  "name": "super-fr \u2014 admin",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {}
  },
  "postCreateCommand": "pipx install uv 2>/dev/null || true; uv tool install 'git+https://github.com/derio-net/super-fr#subdirectory=packages/fr' || true",
  "runArgs": [
    "--env-file",
    "${localEnv:HOME}/.config/fr/secrets/super-fr/admin.env"
  ],
  "customizations": {
    "fr": {
      "profile": "admin",
      "purpose": "in-container gh writes (push, PR)"
    }
  }
}
