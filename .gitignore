__pycache__/
*.pyc
.venv/
.coverage
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Claude Code session lockfile (ScheduleWakeup runtime artifact).
.claude/scheduled_tasks.lock

# Local git worktrees.
.worktrees/

# fr isolation marker (never commit — `fr isolation up` also adds it to
# info/exclude; a CI tripwire fails if it is ever tracked). #328
.fr-isolation

# Operator scratch dir (ad-hoc runnable scripts handed to the operator).
scripts/tmp/

# Dormant npm scaffolding at the repo root. PR #173 removed package.json and
# package-lock.json (nothing reads them since the 2026-04-13 installer
# rewrite that switched to .claude-plugin/*.json). Some editor / IDE tooling
# regenerates an empty package-lock.json on scan; ignore both names *only at
# the root* — packages/fr-opencode-plugin legitimately ships a package.json
# and an unanchored pattern here was silently swallowing it.
/package.json
/package-lock.json
.claude/worktrees/
.DS_STORE

# Node/bun package artifacts (packages/fr-opencode-plugin/ and any future
# JS/TS packages). bun.lock is intentionally NOT ignored — it's committed
# for reproducible installs, same spirit as uv.lock.
node_modules/
*.tsbuildinfo

# ad-hoc acceptance report (committed set is report_local.html / report_linked.{html,md})
docs/acceptance/report.html
