# The acceptance matrix (docs/acceptance/features/*.yaml, folded) rendered + gated.
# - `failing` rows FAIL this pipeline (by design — fix or re-classify).
# - debt rows (`unwired` / `walk-owed` / `not-implemented`) surface as
#   warnings; the backfill rule (.claude/rules/acceptance-matrix.md) owns their lifecycle.
# - The built report is kept as a pipeline artifact, exposed on the merge request
#   (`expose_as`) — GitLab CI has no job-summary equivalent (see module comment).
# - The weekly (scheduled) run upserts one "<repo>: Technical debt" issue and
#   refreshes a draft PR archiving long-merged plans.
# Sister-repo refs are not verifiable here (no checkout) — `fr acceptance
# check` warns and verifies them on local runs, where siblings exist.
# If path filters (`rules:changes:`) are added later, they must include
# every own-repo path the matrix references — `fr acceptance check` warns
# when one falls outside them.

stages:
  - acceptance

acceptance-report:
  stage: acceptance
  image: python:3.14
  variables:
    GIT_DEPTH: "0" # check judges merged rows against the default branch's history
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_PIPELINE_SOURCE == "push"
    - if: $CI_PIPELINE_SOURCE == "schedule"
    - if: $CI_PIPELINE_SOURCE == "web"
  before_script:
    - |
      case "$(uname -m)" in
        x86_64|amd64) url='https://github.com/astral-sh/uv/releases/download/0.13.7/uv-x86_64-unknown-linux-gnu.tar.gz'; sha='c5221ff41b7892bfc223543883600125f6a47fe845093e0f5bdff4f359196d83';;
        aarch64|arm64) url='https://github.com/astral-sh/uv/releases/download/0.13.7/uv-aarch64-unknown-linux-gnu.tar.gz'; sha='71279f8d3c67241e807b9d8db872d1bf541579fb9f08b7d1eb1682196d1e57dc';;
        *) echo "uv 0.13.7: unsupported architecture $(uname -m)" >&2; exit 1;;
      esac
      curl -fsSL "$url" -o /tmp/uv.tar.gz
      echo "$sha  /tmp/uv.tar.gz" | sha256sum -c -
      rm -rf /tmp/uv-x && mkdir -p /tmp/uv-x && tar -xzf /tmp/uv.tar.gz -C /tmp/uv-x --strip-components=1
      mkdir -p "$HOME/.local/bin"
      install -m 755 /tmp/uv-x/uv /tmp/uv-x/uvx "$HOME/.local/bin/"
      export PATH="$HOME/.local/bin:$PATH"
    - uv tool install "git+https://github.com/derio-net/super-fr@0123456789abcdef0123456789abcdef01234567#subdirectory=packages/fr"  # v8.1.5
  script:
    - git fetch origin "+refs/heads/$CI_DEFAULT_BRANCH:refs/remotes/origin/$CI_DEFAULT_BRANCH"
    - fr acceptance check
    - fr acceptance report --link-mode github --ref "$CI_COMMIT_SHA"
  artifacts:
    expose_as: "Acceptance report" # linked from the merge request
    paths:
      - docs/acceptance/report.html
    expire_in: 90 days

# The HTML report on Pages from the default branch. The site must be no wider than the
# repo (fr, spec R21): visibility is re-read before EVERY deploy. A refusal fails the job
# loudly (it was scaffolded only where Pages were allowed, so visibility changed) and
# cannot unpublish a live site. The check reads the forge, so it needs a token: create a
# masked CI/CD variable FR_PAGES_TOKEN with the read_api scope.
pages:
  stage: acceptance
  image: python:3.14
  needs: [acceptance-report]
  variables:
    GIT_DEPTH: "0"
    GITLAB_TOKEN: $FR_PAGES_TOKEN
  rules:
    - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
  before_script:
    - |
      case "$(uname -m)" in
        x86_64|amd64) url='https://github.com/astral-sh/uv/releases/download/0.13.7/uv-x86_64-unknown-linux-gnu.tar.gz'; sha='c5221ff41b7892bfc223543883600125f6a47fe845093e0f5bdff4f359196d83';;
        aarch64|arm64) url='https://github.com/astral-sh/uv/releases/download/0.13.7/uv-aarch64-unknown-linux-gnu.tar.gz'; sha='71279f8d3c67241e807b9d8db872d1bf541579fb9f08b7d1eb1682196d1e57dc';;
        *) echo "uv 0.13.7: unsupported architecture $(uname -m)" >&2; exit 1;;
      esac
      curl -fsSL "$url" -o /tmp/uv.tar.gz
      echo "$sha  /tmp/uv.tar.gz" | sha256sum -c -
      rm -rf /tmp/uv-x && mkdir -p /tmp/uv-x && tar -xzf /tmp/uv.tar.gz -C /tmp/uv-x --strip-components=1
      mkdir -p "$HOME/.local/bin"
      install -m 755 /tmp/uv-x/uv /tmp/uv-x/uvx "$HOME/.local/bin/"
      export PATH="$HOME/.local/bin:$PATH"
    - uv tool install "git+https://github.com/derio-net/super-fr@0123456789abcdef0123456789abcdef01234567#subdirectory=packages/fr"  # v8.1.5
  script:
    - |
      fr acceptance pages-check || {
        echo "Pages deploy refused: visibility not shown to match the repo."
        echo "A skipped deploy does not unpublish a live site: remove Pages in the"
        echo "project settings (Deploy > Pages) by hand."
        exit 1
      }
    - mkdir -p public
    - fr acceptance report --link-mode github --ref "$CI_COMMIT_SHA" --out public/index.html
  artifacts:
    paths:
      - public

# Its own job, so a failing `fr acceptance check` above never skips the debt run.
# It needs a masked CI/CD variable FR_DEBT_TOKEN with the `api` scope: the job's own
# token cannot file issues or merge requests through `glab`, so the job stops with one
# line naming the variable when it is unset.
technical-debt:
  stage: acceptance
  image: python:3.14
  variables:
    GIT_DEPTH: "0"
    GITLAB_TOKEN: $FR_DEBT_TOKEN
    GITLAB_HOST: $CI_SERVER_HOST
  rules:
    - if: $CI_PIPELINE_SOURCE == "schedule"
    - if: $CI_PIPELINE_SOURCE == "web" && $DEBT == "true"
  before_script:
    - |
      [ -n "$FR_DEBT_TOKEN" ] || {
        echo "Set the masked CI/CD variable FR_DEBT_TOKEN (api scope)."; exit 1; }
    - |
      case "$(uname -m)" in
        x86_64|amd64) url='https://github.com/astral-sh/uv/releases/download/0.13.7/uv-x86_64-unknown-linux-gnu.tar.gz'; sha='c5221ff41b7892bfc223543883600125f6a47fe845093e0f5bdff4f359196d83';;
        aarch64|arm64) url='https://github.com/astral-sh/uv/releases/download/0.13.7/uv-aarch64-unknown-linux-gnu.tar.gz'; sha='71279f8d3c67241e807b9d8db872d1bf541579fb9f08b7d1eb1682196d1e57dc';;
        *) echo "uv 0.13.7: unsupported architecture $(uname -m)" >&2; exit 1;;
      esac
      curl -fsSL "$url" -o /tmp/uv.tar.gz
      echo "$sha  /tmp/uv.tar.gz" | sha256sum -c -
      rm -rf /tmp/uv-x && mkdir -p /tmp/uv-x && tar -xzf /tmp/uv.tar.gz -C /tmp/uv-x --strip-components=1
      mkdir -p "$HOME/.local/bin"
      install -m 755 /tmp/uv-x/uv /tmp/uv-x/uvx "$HOME/.local/bin/"
      export PATH="$HOME/.local/bin:$PATH"
    - uv tool install "git+https://github.com/derio-net/super-fr@0123456789abcdef0123456789abcdef01234567#subdirectory=packages/fr"  # v8.1.5
    - |
      case "$(uname -m)" in
        x86_64|amd64) url='https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/packages/generic/glab/1.107.0/glab_1.107.0_linux_amd64.tar.gz'; sha='eb42f56eb1a789cf4f22aa5960ff0ef60cf1e7fc1295327501f9f59030d5ae2c';;
        aarch64|arm64) url='https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/packages/generic/glab/1.107.0/glab_1.107.0_linux_arm64.tar.gz'; sha='8356e442ed42ff6973cbe267dd7371c65f9b810b01e7d70bb557cd284e7b35ba';;
        *) echo "glab 1.107.0: unsupported architecture $(uname -m)" >&2; exit 1;;
      esac
      curl -fsSL "$url" -o /tmp/glab.dl
      echo "$sha  /tmp/glab.dl" | sha256sum -c -
      mkdir -p "$HOME/.local/bin"
      rm -rf /tmp/glab-x && mkdir -p /tmp/glab-x && tar -xzf /tmp/glab.dl -C /tmp/glab-x
      install -m 755 /tmp/glab-x/bin/glab "$HOME/.local/bin/glab"
      export PATH="$HOME/.local/bin:$PATH"
  script:
    - fr debt issue --yes
    - fr debt archive-pr --yes
