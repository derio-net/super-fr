#!/usr/bin/env python3
"""A stateful forge double for tests/scenarios/gate-backfill-apply.sh. It records every call, one
argv per line, to $FAKE_GH_LOG and keeps issues, PR labels and comments in $FAKE_GH_STATE (JSON),
so a second `--yes` sees what the first one wrote. Anything it does not know fails loudly."""
import json
import os
import sys

argv = sys.argv[1:]
with open(os.environ["FAKE_GH_LOG"], "a") as log:
    log.write(" ".join(argv).replace("\n", " | ") + "\n")
path = os.environ["FAKE_GH_STATE"]
state = json.load(open(path))
ME = "scenario-bot"


def save() -> None:
    json.dump(state, open(path, "w"))


def opt(name: str) -> str:
    return argv[argv.index(name) + 1]


def opts(name: str) -> list[str]:
    return [argv[i + 1] for i, a in enumerate(argv) if a == name]


def issue(n: str) -> dict:
    return state["issues"][n]


def fail(msg: str) -> None:
    print(f"fake gh: {msg}: gh {' '.join(argv)}", file=sys.stderr)
    sys.exit(1)


head = argv[:2]
if head == ["api", "user"]:
    print(ME)
elif head == ["issue", "list"]:
    out = [
        {"number": int(n), "title": i["title"], "body": i["body"], "author": {"login": i["author"]},
         "labels": [{"name": x} for x in i["labels"]]}
        for n, i in sorted(state["issues"].items(), key=lambda kv: int(kv[0]))
        if i["state"] == "OPEN"
    ]
    print(json.dumps(out))
elif head == ["issue", "view"]:
    i = issue(argv[2])
    if opt("--json") == "comments":
        print(json.dumps({"comments": [
            {"author": {"login": c["author"]}, "body": c["body"], "url": "", "createdAt": ""}
            for c in i["comments"]]}))
    else:
        print(json.dumps({"state": i["state"], "body": i["body"], "assignees": [],
                          "labels": [{"name": x} for x in i["labels"]]}))
elif head == ["pr", "view"]:
    pr = state["prs"][argv[2]]
    print(json.dumps({"state": "MERGED", "isDraft": False, "headRefOid": "", "headRefName": "feat/widget",
                      "baseRefName": "main", "mergeable": "UNKNOWN", "mergeStateStatus": "UNKNOWN",
                      "mergeCommit": {"oid": ""}, "title": "feat: widget", "body": "",
                      "labels": [{"name": x} for x in pr["labels"]]}))
elif argv[:1] == ["api"] and "/commits/" in argv[1]:
    print('[{"number":12,"state":"closed","merged_at":"2026-10-11T00:00:00Z",'
          '"html_url":"https://github.com/example-org/widgets/pull/12"}]')
elif head == ["label", "create"]:
    state["labels"].append(argv[2])
    save()
elif head == ["issue", "edit"]:
    n = argv[2]
    target = state["prs"].get(n) or issue(n)
    for lab in opts("--add-label"):
        if lab not in state["labels"]:
            fail("label not found")
        target["labels"].append(lab) if lab not in target["labels"] else None
    for lab in opts("--remove-label"):
        target["labels"] = [x for x in target["labels"] if x != lab]
    if "--body" in argv:
        target["body"] = opt("--body")
    save()
elif head == ["issue", "create"]:
    for lab in opts("--label"):
        if lab not in state["labels"]:
            fail("label not found")
    n = str(state["next"])
    state["next"] += 1
    state["issues"][n] = {"title": opt("--title"), "body": opt("--body"), "author": ME,
                          "labels": opts("--label"), "state": "OPEN", "comments": []}
    save()
    print(f"https://github.com/example-org/widgets/issues/{n}")
elif head == ["issue", "comment"]:
    issue(argv[2])["comments"].append({"author": ME, "body": opt("--body")})
    save()
elif head == ["issue", "close"]:
    issue(argv[2])["state"] = "CLOSED"
    save()
else:
    fail("unexpected call")
