#!/usr/bin/env bash
# A recording forge double for tests/scenarios/owed-reuse-uncapped.sh. Every call is one
# argv line in $FAKE_GH_LOG. `gh issue list` answers by $FAKE_GH_MODE:
#   many   : with `--label fr:owed`, the ONE owed issue; with no label filter, 250
#            unrelated issues (what an unfiltered 200-issue read would see instead);
#   limit  : with `--label fr:owed`, exactly `--limit` owed issues of other keys (a
#            listing that reached its limit may have missed the marker).
# Anything it does not know fails loudly, so a new forge call cannot slip through.
log="${FAKE_GH_LOG:?FAKE_GH_LOG is required}"
printf '%s\n' "$*" >> "$log"
case "$1 ${2:-}" in
  "api user") echo scenario-bot ;;
  "issue list")
    python3 - "$FAKE_GH_MODE" "$FAKE_GH_KEY" "$*" <<'PY'
import json, re, sys
mode, key, argv = sys.argv[1:4]
label = "--label fr:owed" in argv
limit = int(re.search(r"--limit (\d+)", argv).group(1))
author = {"login": "scenario-bot"}
def owed(n, k):
    return {"number": n, "url": f"https://github.com/example-org/widgets/issues/{n}",
            "body": f"Owed\n\n<!-- fr-owed:{k} -->", "author": author,
            "labels": [{"name": "fr:owed"}]}
if mode == "many" and label:
    out = [owed(7, key)]
elif mode == "many":
    out = [{"number": n, "body": "x", "author": author, "labels": []} for n in range(100, 350)][:limit]
elif mode == "limit" and label:
    out = [owed(n, f"spec:other#step{n}") for n in range(1, limit + 1)]
else:
    out = []
print(json.dumps(out))
PY
    ;;
  "label create") : ;;
  "issue create") echo "https://github.com/example-org/widgets/issues/900" ;;
  *) echo "fake gh: unexpected call: gh $*" >&2; exit 1 ;;
esac
